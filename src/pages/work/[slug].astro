---
import PortfolioLayout from '../../layouts/PortfolioLayout.astro';
import { projects, getProject } from '../../data/projects';

export function getStaticPaths() {
	return projects.map((project) => ({
		params: { slug: project.slug },
	}));
}

const { slug } = Astro.params;
const project = slug ? getProject(slug) : undefined;

if (!project) {
	return Astro.redirect('/#work');
}

const others = projects.filter((p) => p.slug !== project.slug).slice(0, 3);
---

<PortfolioLayout title={project.title} description={project.summary}>
	<article class="wrap py-16 sm:py-20">
		<p class="reveal text-center">
			<a href="/#work" class="nav-link">← All work</a>
		</p>

		<header class="wrap-narrow reveal mt-12 text-center">
			<p class="eyebrow">{project.category} · {project.year}</p>
			<h1 class="display mt-5 text-[clamp(2.2rem,6vw,3.6rem)]">{project.title}</h1>
			{project.role && <p class="display-italic mt-2 text-lg text-accent">{project.role}</p>}
			<p class="lede mt-7">{project.description}</p>
			{
				(project.github || project.href) && (
					<div class="mt-8 flex justify-center gap-3">
						{project.github && (
							<a class="btn-fill" href={project.github} target="_blank" rel="noopener noreferrer">
								Source
							</a>
						)}
						{project.href && (
							<a class="btn-ghost" href={project.href} target="_blank" rel="noopener noreferrer">
								Live
							</a>
						)}
					</div>
				)
			}
		</header>

		<div class="wrap-narrow mt-20 space-y-14">
			<section class="reveal">
				<p class="eyebrow">Problem</p>
				<p class="mt-4 text-[1.02rem] leading-[1.8] text-ink-soft">{project.caseStudy.problem}</p>
			</section>

			<section class="reveal">
				<p class="eyebrow">Approach</p>
				<ol class="mt-6 space-y-6">
					{
						project.caseStudy.approach.map((item, i) => (
							<li class="grid grid-cols-[2.5rem_1fr] gap-3">
								<span class="mono pt-1.5 text-accent-dim">{String(i + 1).padStart(2, '0')}</span>
								<span class="text-[1.02rem] leading-[1.8] text-ink-soft">{item}</span>
							</li>
						))
					}
				</ol>
			</section>

			<section class="reveal">
				<p class="eyebrow">Outcome</p>
				<p class="mt-4 text-[1.02rem] leading-[1.8] text-ink-soft">{project.caseStudy.outcome}</p>
				{
					project.caseStudy.notes && (
						<ul class="mt-5 space-y-2 text-sm text-ink-dim">
							{project.caseStudy.notes.map((note) => (
								<li class="relative pl-5">
									<span
										class="absolute left-0 top-[0.7em] h-1 w-1 rounded-full bg-accent-dim"
										aria-hidden="true"
									/>
									{note}
								</li>
							))}
						</ul>
					)
				}
			</section>

			{
				project.stack && (
					<section class="panel reveal p-7">
						<p class="eyebrow">Stack</p>
						<ul class="mt-4 space-y-1.5 text-sm text-ink-soft">
							{project.stack.map((item) => (
								<li>{item}</li>
							))}
						</ul>
					</section>
				)
			}
		</div>

		<nav class="wrap-narrow reveal mt-24 border-t border-rule pt-10">
			<p class="eyebrow text-center">More work</p>
			<ul class="mt-6">
				{
					others.map((p) => (
						<li>
							<a
								href={`/work/${p.slug}`}
								class="group flex items-baseline justify-between gap-4 border-b border-rule py-4"
							>
								<span class="display text-xl transition-colors group-hover:text-accent">
									{p.title}
								</span>
								<span class="mono shrink-0 text-ink-dim transition-colors group-hover:text-accent">
									{p.category}
								</span>
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</article>
</PortfolioLayout>
