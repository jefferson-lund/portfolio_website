---
import { site } from '../config/site';

interface Props {
	size?: 'default' | 'lg';
	show?: Array<'github' | 'linkedin' | 'email' | 'ajdata'>;
}

const { size = 'default', show = ['github', 'linkedin', 'email'] } = Astro.props;
const large = size === 'lg';
const iconSize = large ? 20 : 16;
const btnClass = large ? 'contact-social' : 'icon-btn';
---

<div class:list={['flex flex-wrap items-center justify-center', large ? 'gap-3' : 'gap-1']}>
	{
		show.includes('email') && (
			<a class={`${btnClass} contact-social--email`} href={`mailto:${site.email}`} aria-label="Email">
				<svg
					class="icon"
					width={iconSize}
					height={iconSize}
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.8"
					aria-hidden="true"
				>
					<path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5v10.5H3.75z"></path>
					<path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75l8.25 6 8.25-6"></path>
				</svg>
				{large && <span>{site.email}</span>}
			</a>
		)
	}
	{
		show.includes('github') && (
			<a
				class={btnClass}
				href={site.github}
				target="_blank"
				rel="noopener noreferrer"
				aria-label="GitHub"
			>
				<svg class="icon" width={iconSize} height={iconSize} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
					<path
						fill-rule="evenodd"
						clip-rule="evenodd"
						d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
					></path>
				</svg>
				{large && <span>GitHub</span>}
			</a>
		)
	}
	{
		show.includes('linkedin') && (
			<a
				class={btnClass}
				href={site.linkedin}
				target="_blank"
				rel="noopener noreferrer"
				aria-label="LinkedIn"
			>
				<svg class="icon" width={iconSize} height={iconSize} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
					<path
						d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.537H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.54v11.452z"
					></path>
				</svg>
				{large && <span>LinkedIn</span>}
			</a>
		)
	}
	{
		show.includes('ajdata') && (
			<a
				class={`${btnClass} contact-social--label`}
				href={site.ajDataSolutions.url}
				target="_blank"
				rel="noopener noreferrer"
				aria-label={site.ajDataSolutions.label}
			>
				<svg
					class="icon"
					width={iconSize}
					height={iconSize}
					viewBox="0 0 16 16"
					fill="currentColor"
					aria-hidden="true"
				>
					<rect x="2.5" y="9" width="2.2" height="4.5" rx="0.4" />
					<rect x="6.2" y="6.5" width="2.2" height="7" rx="0.4" />
					<rect x="9.9" y="4" width="2.2" height="9.5" rx="0.4" />
				</svg>
				{large && <span>{site.ajDataSolutions.label}</span>}
			</a>
		)
	}
</div>
