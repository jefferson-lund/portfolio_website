---
import { jsDelivrIconUrl, simpleIconUrl, toolIcons } from '../config/toolIcons';

type Props = { label: string };
const { label } = Astro.props;
const icon = toolIcons[label];
---

<li class="pill pill-toolkit">
	{
		icon?.type === 'simple' ? (
			<img
				class="pill-icon"
				src={simpleIconUrl(icon.slug)}
				alt=""
				width="14"
				height="14"
				loading="lazy"
				decoding="async"
			/>
		) : icon?.type === 'jsdelivr' ? (
			<img
				class="pill-icon pill-icon-brand"
				src={jsDelivrIconUrl(icon.slug)}
				alt=""
				width="14"
				height="14"
				loading="lazy"
				decoding="async"
				data-chart-fallback=""
			/>
		) : icon?.type === 'builtin' ? (
			<svg class="pill-icon" viewBox="0 0 16 16" aria-hidden="true">
				{
					icon.icon === 'sql' && (
						<>
							<ellipse cx="8" cy="4.5" rx="5.5" ry="2" fill="none" stroke="currentColor" stroke-width="1.2" />
							<path
								d="M2.5 4.5v3c0 1.1 2.46 2 5.5 2s5.5-.9 5.5-2v-3"
								fill="none"
								stroke="currentColor"
								stroke-width="1.2"
							/>
							<path
								d="M2.5 7.5v3c0 1.1 2.46 2 5.5 2s5.5-.9 5.5-2v-3"
								fill="none"
								stroke="currentColor"
								stroke-width="1.2"
							/>
						</>
					)
				}
				{
					icon.icon === 'iceberg' && (
						<>
							<path d="M3 11.5 8 4.5l5 7" fill="none" stroke="currentColor" stroke-width="1.2" />
							<path d="M5.5 11.5h5" fill="none" stroke="currentColor" stroke-width="1.2" />
							<path d="M6.5 9h3" fill="none" stroke="currentColor" stroke-width="1.2" />
						</>
					)
				}
				{
					icon.icon === 'chart' && (
						<>
							<rect x="2.5" y="9" width="2.2" height="4.5" rx="0.4" fill="currentColor" />
							<rect x="6.2" y="6.5" width="2.2" height="7" rx="0.4" fill="currentColor" />
							<rect x="9.9" y="4" width="2.2" height="9.5" rx="0.4" fill="currentColor" />
							<path d="M2.5 13.5h11" fill="none" stroke="currentColor" stroke-width="1.1" />
						</>
					)
				}
				{
					icon.icon === 'tableau' && (
						<>
							<rect x="3.8" y="3.8" width="2.4" height="2.4" rx="0.35" fill="currentColor" />
							<rect x="9.8" y="3.8" width="2.4" height="2.4" rx="0.35" fill="currentColor" />
							<rect x="3.8" y="9.8" width="2.4" height="2.4" rx="0.35" fill="currentColor" />
							<rect x="9.8" y="9.8" width="2.4" height="2.4" rx="0.35" fill="currentColor" />
							<path d="M4.8 3.3v3.4M11.8 3.3v3.4M4.8 9.3v3.4M11.8 9.3v3.4M3.3 4.8h3.4M9.3 4.8h3.4M3.3 10.8h3.4M9.3 10.8h3.4" fill="none" stroke="currentColor" stroke-width="0.65" stroke-linecap="round" />
						</>
					)
				}
				{
					icon.icon === 'powerquery' && (
						<>
							<rect x="2.5" y="3.5" width="11" height="5.5" rx="0.7" fill="none" stroke="currentColor" stroke-width="1.1" />
							<path d="M4.2 6.2h7.6M4.2 8.1h4.8" fill="none" stroke="currentColor" stroke-width="0.9" stroke-linecap="round" />
							<path d="M10.8 10.2 12.8 12.2 10.8 14.2" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round" />
							<path d="M7.2 12.2h5.6" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" />
						</>
					)
				}
				{
					icon.icon === 'virtualization' && (
						<>
							<rect x="2.5" y="3" width="11" height="4.5" rx="0.8" fill="none" stroke="currentColor" stroke-width="1.2" />
							<rect x="2.5" y="8.5" width="11" height="4.5" rx="0.8" fill="none" stroke="currentColor" stroke-width="1.2" />
						</>
					)
				}
				{
					icon.icon === 'cloud' && (
						<path
							d="M5 11.5h6.2a2.8 2.8 0 0 0 .2-5.6A3.6 3.6 0 0 0 5.4 4.6 2.8 2.8 0 0 0 5 11.5Z"
							fill="none"
							stroke="currentColor"
							stroke-width="1.2"
						/>
					)
				}
				{
					icon.icon === 'api' && (
						<>
							<path d="M5.5 5.5 3 8l2.5 2.5" fill="none" stroke="currentColor" stroke-width="1.2" />
							<path d="M10.5 5.5 13 8l-2.5 2.5" fill="none" stroke="currentColor" stroke-width="1.2" />
							<path d="M9 4.5 7 11.5" fill="none" stroke="currentColor" stroke-width="1.2" />
						</>
					)
				}
			</svg>
		) : (
			<svg class="pill-icon" viewBox="0 0 16 16" aria-hidden="true">
				<rect x="2.5" y="9" width="2.2" height="4.5" rx="0.4" fill="currentColor" />
				<rect x="6.2" y="6.5" width="2.2" height="7" rx="0.4" fill="currentColor" />
				<rect x="9.9" y="4" width="2.2" height="9.5" rx="0.4" fill="currentColor" />
				<path d="M2.5 13.5h11" fill="none" stroke="currentColor" stroke-width="1.1" />
			</svg>
		)
	}
	{label}
</li>

<script>
	const chartFallback = () => {
		const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
		svg.setAttribute('class', 'pill-icon');
		svg.setAttribute('viewBox', '0 0 16 16');
		svg.setAttribute('aria-hidden', 'true');
		svg.innerHTML =
			'<rect x="2.5" y="9" width="2.2" height="4.5" rx="0.4" fill="currentColor"></rect><rect x="6.2" y="6.5" width="2.2" height="7" rx="0.4" fill="currentColor"></rect><rect x="9.9" y="4" width="2.2" height="9.5" rx="0.4" fill="currentColor"></rect><path d="M2.5 13.5h11" fill="none" stroke="currentColor" stroke-width="1.1"></path>';
		return svg;
	};

	document.querySelectorAll<HTMLImageElement>('.pill-toolkit img[data-chart-fallback]').forEach((img) => {
		img.addEventListener('error', () => {
			img.replaceWith(chartFallback());
		});
	});
</script>
