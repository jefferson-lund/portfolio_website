---
import type { Project } from '../data/projects';

type Props = { project: Project; index: number };
const { project, index } = Astro.props;
const number = String(index + 1).padStart(2, '0');
---

<a href={`/work/${project.slug}`} class="work-row reveal group">
	<p class="mono text-ink-dim">{number}</p>
	<div>
		<p class="mono text-accent">{project.category}</p>
		<h3 class="display mt-2 text-2xl text-ink transition-colors group-hover:text-accent">
			{project.title}
		</h3>
		<p class="mt-3 max-w-2xl text-[0.95rem] leading-relaxed text-ink-soft">{project.summary}</p>
		<ul class="mt-4 flex flex-wrap gap-1.5">
			{project.tags.map((tag) => <li class="pill">{tag}</li>)}
		</ul>
	</div>
	<p class="mono self-start text-ink-dim transition-colors group-hover:text-accent md:text-right">
		{project.year}
		<span class="mt-2 block">Read →</span>
	</p>
</a>
