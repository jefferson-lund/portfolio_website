---
type Props = {
	index: string;
	label: string;
	title: string;
	lede?: string;
};

const { index, label, title, lede } = Astro.props;
---

<div class="section-head">
	<p class="eyebrow reveal">{index} — {label}</p>
	<h2 class="section-title reveal">{title}</h2>
	{lede && <p class="lede reveal max-w-xl">{lede}</p>}
</div>
